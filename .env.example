# PostgreSQL connection string for the application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Use two different, randomly generated secrets (at least 32 characters each).
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# Optional settings; these defaults are used when omitted.
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
BUSINESS_TIMEZONE="America/Bogota"
